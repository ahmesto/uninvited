# Python
__pycache__/
*.pyc
.venv/

# Captured attacker data and anything that could hold credentials
data/
*.db
*.db-wal
*.db-shm
*.tgz
*.bak

# Your real config (home-specific addresses). Use config.example.yaml as the template.
config.live.yaml
config.local.yaml

# Keys and secrets, in case one ever lands in the folder
